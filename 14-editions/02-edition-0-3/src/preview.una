module preview

-- Edition 0.3 is a preview: conditions on operations, boundaries and locked contracts
-- live there, and may still change before it is stable.
show(text: Text, quiet: Bool) -> Unit
  uses @console: Console[print where not quiet]
=
  if not quiet
    @console.print(text)
  unit

pub main() -> Unit
  uses @console: Console[print]
=
  show("edition 0.3", quiet: false)
