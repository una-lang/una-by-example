module prices

-- Edition 0.3: an operation in `uses` may carry a condition, `where`. `print` may run only
-- where `not quiet` holds, and the verifier proves that of every place that prints.
report(total: Int, quiet: Bool) -> Unit
  uses @console: Console[print where not quiet]
=
  @console.print("total: {total}")

pub main() -> Unit
  uses @console: Console[print]
=
  report(42, quiet: false)
  report(7, quiet: true)
