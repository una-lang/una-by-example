module notes

-- `Files` is a host capability: `una run` provides it only as `una.toml` grants it. Here the
-- grant `files:src:read,write` lets the program read and write under `src`, and nothing else.
-- What `read` returns is labeled `internal`: it may be written to a file, not printed.
pub main() -> Unit
  uses @console: Console[print]
  uses @files: Files[read, write]
=
  let text = @files.read("notes.txt")
    if error use "(no notes)"
  @files.write("copy.txt", content: text)
    if error use unit
  @console.print("copied the notes")
