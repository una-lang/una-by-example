module greetings

-- A capability of your own: a set of operations, with no code.
capability Greeting
  op greet(name: Text) -> Text

-- A handler gives the operations their code. Several handlers can implement one capability.
handler english() for Greeting
  op greet(name) = "Hello, {name}"

handler portuguese() for Greeting
  op greet(name) = "Olá, {name}"

welcome(name: Text) -> Text
  uses @greeting: Greeting[greet]
=
  @greeting.greet(name)

pub main() -> Unit
  uses @console: Console[print]
=
  -- `with` installs a handler for one call: the callee's `@greeting` is that handler.
  let first = welcome("Ana") with @greeting = english()
  let second = welcome("Ana") with @greeting = portuguese()
  @console.print(first)
  @console.print(second)
