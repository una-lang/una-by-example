module rebinding

-- `banner` asks for a binding named `@out`.
banner(text: Text) -> Unit
  uses @out: Console[print]
=
  @out.print("== {text} ==")

pub main() -> Unit
  uses @console: Console[print]
=
  -- `with @out = @console` hands the callee's `@out` the caller's `@console`, for this
  -- call only. A capability is never taken: the caller always says what it hands over.
  banner("start") with @out = @console
  @console.print("done")
