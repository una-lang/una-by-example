module tasks

slow_square(n: Int) -> Int = n * n

pub main() -> Unit
  uses @console: Console[print]
=
  -- `together` runs its `let` branches as concurrent tasks, and all of them end before the
  -- block does. The result is the same as running them one after another, in order.
  together
    let a = slow_square(3)
    let b = slow_square(4)
  -- `together for` runs one task per element; the results come back in list order.
  let squares = together for n in [1, 2, 3, 4]
    slow_square(n)
  @console.print("{a + b}")
  @console.print(squares.map(each: fn(s) -> "{s}").join(separator: " "))
