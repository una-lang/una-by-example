module tally

-- Values stay values: there are no references. An `edit` parameter is passed in and out,
-- and `old(t)` in `ensures` is its value on entry.
kind Tally
  seen: Int
  total: Int

record(edit t: Tally, value: Int) -> Unit
  ensures t.seen == old(t).seen + 1
=
  t.seen = t.seen + 1
  t.total = t.total + value

-- A `take` parameter consumes its argument: the caller cannot use it afterwards.
finish(take t: Tally) -> Text = "{t.seen} values, total {t.total}"

pub main() -> Unit
  uses @console: Console[print]
=
  let edit t = Tally(seen: 0, total: 0)
  for x in [3, 4, 5]
    edit t.record(value: x)
  let summary = finish(take t)
  @console.print(summary)
