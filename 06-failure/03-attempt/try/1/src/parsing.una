module parsing

kind ParseError = | NotANumber

number(text: Text) -> Int
  fails ParseError
=
  let n = text.to_int()
    if none fail NotANumber
  n

-- `attempt` turns one call that may fail into a `Result`: `Ok(value)` or `Err(failure)`.
-- Then `when` branches on it, as on any sum.
show(text: Text) -> Text
=
  let outcome = attempt number(text) + 1
  when outcome
    is Ok(value) -> "a number: {value}"
    is Err(failure) -> "not a number: {text}"

pub main() -> Unit
  uses @console: Console[print]
=
  @console.print(show("42"))
  @console.print(show("forty-two"))
