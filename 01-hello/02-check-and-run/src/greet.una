module greet

-- A function of one `Int` that returns an `Int`. `una check` proves the types of every call.
double(n: Int) -> Int = n * 2

pub main() -> Unit
  uses @console: Console[print]
=
  let answer = double(21)
  -- `{answer}` puts the value into the text.
  @console.print("the answer is {answer}")
