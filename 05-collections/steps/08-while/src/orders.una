module orders

--- One line of an order: a SKU, the category it is sold under, and how many units.
kind OrderLine
  sku: Text
  category: Text
  quantity: Int

--- An order: its number and its lines.
kind Order
  number: Int
  lines: List[OrderLine]

--- A change to the stock of one SKU.
kind Movement = Received(units: Int) | Sold(units: Int) | Lost(units: Int)

--- The units of lighting, and of everything else: an `if` with an `else` inside a loop.
lighting_and_other(lines: List[OrderLine]) -> Text
=
  let edit lighting = 0
  let edit other = 0
  for line in lines
    if line.category == "lighting"
      lighting = lighting + line.quantity
    else
      other = other + line.quantity
  "lighting {lighting}, other {other}"

--- The stock after a day of movements, from `start` units: a `when` inside a loop.
stock_after(start: Int, movements: List[Movement]) -> Int
=
  let edit stock = start
  for movement in movements
    when movement
      is Received(units) ->
        stock = stock + units
      is Sold(units) ->
        stock = stock - units
      is Lost(units) ->
        stock = stock - units
  stock

--- Every unit of every order: a loop inside a loop.
all_units(orders: List[Order]) -> Int
=
  let edit total = 0
  for order in orders
    for line in order.lines
      total = total + line.quantity
  total

--- Every SKU of a T-shirt, one for each color and size, such as `TEE-RED-S`.
tee_skus(colors: List[Text], sizes: List[Text]) -> List[Text]
=
  let edit skus: List[Text] = []
  for color in colors
    for size in sizes
      skus = skus.append(item: "TEE-{color}-{size}")
  skus

--- How many whole weeks `stock` units last when `per_week` units sell each week.
weeks_of_stock(stock: Int, per_week: Int) -> Int
  requires per_week >= 1
=
  let edit left = stock
  let edit weeks = 0
  while left >= per_week
    left = left - per_week
    weeks = weeks + 1
  weeks

--- How many shelves hold fewer than 2 units.
low_shelves(counts: List[Int]) -> Int
=
  let edit low = 0
  for count in counts
    if count < 2
      low = low + 1
  low

--- The total after each line, in order.
running(quantities: List[Int]) -> List[Int]
=
  let edit total = 0
  let edit seen: List[Int] = []
  for quantity in quantities
    total = total + quantity
    seen = seen.append(item: total)
  seen

pub main() -> Unit
  uses @console: Console[print]
=
  let lamp = OrderLine(sku: "LAMP-01", category: "lighting", quantity: 2)
  let desk = OrderLine(sku: "DESK-02", category: "furniture", quantity: 1)
  let shade = OrderLine(sku: "SHADE-05", category: "lighting", quantity: 3)
  @console.print(lighting_and_other([lamp, desk, shade]))
  let day = [Received(units: 10), Sold(units: 3), Lost(units: 1), Sold(units: 2)]
  @console.print("stock at closing: {stock_after(4, movements: day)}")
  let morning = Order(number: 1001, lines: [lamp, desk])
  let evening = Order(number: 1002, lines: [shade])
  @console.print("units in two orders: {all_units([morning, evening])}")
  let colors = ["RED", "BLUE"]
  let sizes = ["S", "M"]
  @console.print("{tee_skus(colors, sizes)}")
  @console.print("10 units at 3 a week last {weeks_of_stock(10, per_week: 3)} weeks")
  @console.print("low shelves: {low_shelves([3, 0, 1, 5])}")
  @console.print("running totals: {running([2, 1, 3])}")
