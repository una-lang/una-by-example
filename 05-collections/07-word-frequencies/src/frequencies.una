module frequencies

-- Testcase: count the words of a text with a map, then print them in order.
counts(text: Text) -> Map[Text, Int]
=
  let edit seen: Map[Text, Int] = empty_map()
  for word in text.split(on: " ").filter(keep: fn(w) -> w.len > 0)
    let before = seen.get(key: word).or_else(default: 0)
    edit seen.set(key: word, value: before + 1)
  seen

pub main() -> Unit
  uses @console: Console[print]
=
  let found = counts("the cat saw the dog and the bird")
  for entry in found.entries()
    @console.print("{entry.key}: {entry.value}")
