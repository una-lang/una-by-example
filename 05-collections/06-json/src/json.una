module json

-- `Json` is a kind of the prelude, with a variant for each kind of JSON value.
-- `to_json` writes one canonical text: object keys in order, no spaces.
pub main() -> Unit
  uses @console: Console[print]
=
  let edit fields: Map[Text, Json] = empty_map()
  edit fields.set(key: "name", value: Str(value: "Una"))
  edit fields.set(key: "pages", value: Number(value: 79))
  edit fields.set(key: "tags", value: Array(items: [Str(value: "learn"), Boolean(value: true)]))
  @console.print(to_json(Object(fields)))
