module lists

pub main() -> Unit
  uses @console: Console[print]
=
  -- A list holds values of one type, in order. It is a value: `append` returns a new list.
  let primes = [2, 3, "5", 7]
  let more = primes.append(item: 11)
  @console.print("{primes.len} then {more.len}")
  @console.print("has 5: {more.contains(item: 5)}")
  @console.print("total: {more.sum()}")
