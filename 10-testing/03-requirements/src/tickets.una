module tickets

-- A requirement records an intent in words, with where it came from and who owns it.
requirement SOLD_OUT_1
  text "An event with no seats left is always shown as sold out"
  source human
  owner box_office
  status active

kind Availability = SoldOut | Open

-- `derived from` ties the contract to the requirement, and `una trace SOLD_OUT_1` shows the
-- chain: the requirement, the contracts derived from it, and their proofs.
pub availability(remaining: Int) -> Availability
  ensures remaining < 1 implies result is SoldOut
  derived from SOLD_OUT_1
=
  if remaining < 1 then SoldOut else Open

pub main() -> Unit
  uses @console: Console[print]
=
  let shown = availability(0)
  @console.print(if shown is SoldOut then "sold out" else "open")
