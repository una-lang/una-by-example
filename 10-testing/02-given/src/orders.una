module orders

kind OrderError = | OutOfStock

capability Stock
  op reserve(item: Text) -> Bool

capability Mail
  op send(to: Text, body: Text) -> Unit

-- Confirm by mail only an order whose item could be taken from stock.
order(item: Text, customer: Text) -> Unit
  uses @stock: Stock[reserve]
  uses @mail: Mail[send]
  fails OrderError
=
  let reserved = @stock.reserve(item)
  if reserved
    @mail.send(customer, body: "{item} is on its way")
  else
    fail OutOfStock

handler shelf(has: Bool) for Stock
  op reserve(item) = has

handler outbox() for Mail
  op send(to, body) = unit

-- `given` installs a handler for the example, so a test never touches the real world.
-- `expect performed` and `expect not performed` check which operations ran.
example "an item in stock is mailed"
  given @stock = shelf(true)
  given @mail = outbox()
  do order("lamp", customer: "ana@example.invalid")
  expect performed @mail.send

example "an item out of stock fails, and nothing is mailed"
  given @stock = shelf(false)
  given @mail = outbox()
  do order("lamp", customer: "ana@example.invalid")
  expect fails OutOfStock
  expect not performed @mail.send

pub main() -> Unit
  uses @console: Console[print]
=
  @console.print("try `una test .`")
