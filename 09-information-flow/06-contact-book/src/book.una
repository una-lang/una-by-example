module book

import privacy (initials)

-- Testcase: a contact book whose phone numbers and names never reach the console. The
-- checker proves it: the only way out is the policy `initials`.
kind Contact
  name: secret[PII] Text
  phone: secret[PII] Text
  city: Text

pub main() -> Unit
  uses @console: Console[print]
=
  let book = [Contact(name: "Ana", phone: "11911112222", city: "Recife"), Contact(name: "Rui", phone: "21933334444", city: "Porto")]
  for c in book
    @console.print("{initials(c.name)} in {c.city}")
