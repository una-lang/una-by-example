module bonus

-- A branch on a secret makes everything it decides secret too, even constants: from the
-- answer, one could learn the secret. So the result here must be labeled `secret`.
gets_bonus(score: secret Int) -> secret Bool = if score > 90 then true else false

pub main() -> Unit
  uses @console: Console[print]
=
  let decided = gets_bonus(95)
  @console.print("decided")
