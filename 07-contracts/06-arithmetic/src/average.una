module average

-- Division by zero is not a runtime error in Una: every division is an obligation, proven
-- before the program runs. So is every fixed-width operation that could overflow.
average(xs: List[Int]) -> Int
=
  if xs.len == 0
    0
  else
    xs.sum() / xs.len

pub main() -> Unit
  uses @console: Console[print]
=
  @console.print("{average([3, 4, 8])} {average([])}")
