module account

-- Testcase: a balance that can never go negative, proven rather than tested.
kind Balance = Int where it >= 0

kind AccountError = Insufficient(needed: Int) | NotPositive

deposit(b: Balance, amount: Int) -> Balance
  requires amount > 0
  ensures result == b + amount
=
  b + amount

withdraw(b: Balance, amount: Int) -> Balance
  fails AccountError
=
  if amount <= 0
    fail NotPositive
  else if amount > b
    fail Insufficient(needed: amount - b)
  else
    b - amount

pub main() -> Unit
  uses @console: Console[print]
=
  let start: Balance = 50
  let more = deposit(start, amount: 25)
  let after = withdraw(more, amount: 100)
    if error use more
  let rest = withdraw(more, amount: 60)
    if error use 0
  @console.print("{more} {after} {rest}")
