module clamp

-- `ensures` is a postcondition, about `result`. The verifier proves it on every path that
-- returns, so callers may rely on it without reading the body.
clamp(x: Int, low: Int, high: Int) -> Int
  requires low <= high
  ensures low <= result and result <= high
=
  if x < low
    low
  else if x > high
    high
  else
    x

pub main() -> Unit
  uses @console: Console[print]
=
  @console.print("{clamp(150, low: 0, high: 100)} {clamp(-5, low: 0, high: 100)} {clamp(42, low: 0, high: 100)}")
