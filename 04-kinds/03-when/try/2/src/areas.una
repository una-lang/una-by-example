module areas

kind Shape = Circle(radius: Int) | Rectangle(width: Int, height: Int) | Dot

-- `when` picks the arm of the value's variant and binds its fields by name. The checker
-- makes sure every variant has an arm.
area_times_100(s: Shape) -> Int
=
  when s
    is Circle(radius) -> 314 * radius * radius
    is Rectangle(width, height) -> 100 * width * height
    is Dot -> 0

-- Literal arms end with `else`, so every value has one.
name_of(code: Int) -> Text
=
  when code
    is 1 -> "one"
    is 2 -> "two"

pub main() -> Unit
  uses @console: Console[print]
=
  @console.print("{area_times_100(Circle(radius: 1))} {area_times_100(Rectangle(width: 2, height: 3))}")
  @console.print(name_of(2))
