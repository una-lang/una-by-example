module billing

-- `una.toml` locks the condition on `print` in `charge`'s header. Whoever edits this file
-- cannot weaken it without changing the lock, which is reviewed apart.
pub charge(amount: Int, dry_run: Bool) -> Unit
  uses @console: Console[print]
=
  if not dry_run
    @console.print("charged {amount}")
  unit

pub main() -> Unit
  uses @console: Console[print]
=
  charge(30, dry_run: false)
  charge(99, dry_run: true)
