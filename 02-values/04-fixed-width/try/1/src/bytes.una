module bytes

-- A fixed-width type holds exactly what its width allows. The verifier proves that
-- `a + b` stays in range: here, because of the two `requires`.
add(a: U8, b: U8) -> U8
  requires a <= 200
  requires b <= 100
=
  a + b

pub main() -> Unit
  uses @console: Console[print]
=
  let small: U8 = 100
  let sum = add(small, b: 55)
  @console.print("{sum.to_int()}")
