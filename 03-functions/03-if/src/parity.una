module parity

-- `if` is an expression: both branches give a value, of the same type.
parity(n: Int) -> Text = if n mod 2 == 0 then "even" else "odd"

-- Over several lines, each branch is a block, and its last line is its value.
describe(n: Int) -> Text
=
  if n < 0
    "negative"
  else if n == 0
    "zero"
  else
    "positive and {parity(n)}"

pub main() -> Unit
  uses @console: Console[print]
=
  @console.print(describe(-3))
  @console.print(describe(0))
  @console.print(describe(7))
