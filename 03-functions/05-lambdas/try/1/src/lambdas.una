module lambdas

-- A parameter of function type: `fn(Int) -> Int` takes an `Int` and returns one.
twice(f: fn(Int) -> Int, x: Int) -> Int = f(f(x))

add_three(n: Int) -> Int = n + 3

pub main() -> Unit
  uses @console: Console[print]
=
  -- A named function is a value...
  let a = twice(add_three, x: 1)
  -- ...and so is a lambda, `fn(params) -> body`, whose body is one line.
  let b = twice(fn(n) -> n * 10, x: 2)
  let keep = fn(n) -> n + 1
  @console.print("{a} {b}")
