module area

-- Parameters have types, and so does the result. Types are never inferred in a header.
rectangle(width: Int, height: Int) -> Int = width * height

pub main() -> Unit
  uses @console: Console[print]
=
  -- The first argument may go without a label; every other one takes its parameter's name.
  let a = rectangle(3, 4)
  -- A variable named like the parameter needs no label: `height` here stands for
  -- `height: height`.
  let height = 10
  let b = rectangle(2, height)
  @console.print("{a} and {b}")
