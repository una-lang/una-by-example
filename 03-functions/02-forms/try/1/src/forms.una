module forms

-- The short form: no clauses, and a body of one line after `=`.
square(n: Int) -> Int
=
  n * n

-- The long form: the header and its clauses, then `=` alone, then the body, indented.
-- `ensures` is a clause, so this function needs the long form.
triple(n: Int) -> Int
  ensures result == 3 * n
=
  let twice = n + n
  twice + n

pub main() -> Unit
  uses @console: Console[print]
=
  @console.print("{square(4)} {triple(5)}")
